{
  "name": "agentbridge-host-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "pair": "tsx src/pair.ts",
    "ui:bind": "tsx src/ui-cli.ts bind",
    "ui:inspect": "tsx src/ui-cli.ts inspect",
    "ui:probe": "tsx src/ui-cli.ts probe",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@types/ws": "^8.18.2",
    "selfsigned": "^5.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  }
}
