# Run from the repository's hostUi folder. Copy manually to .env and review.
# Keep loopback unless private-network phone access is intentionally configured.
HOST_UI_BIND=127.0.0.1
HOST_UI_PORT=8444
HOST_UI_DATA_DIR=.\.data

# Supply new certificate/key files, or explicitly reuse only an existing TLS
# identity after checking its SAN matches the address used by the phone.
HOST_UI_TLS_CERT_PATH=.\certs\host.crt
HOST_UI_TLS_KEY_PATH=.\certs\host.key
# Optional existing TLS paths (not device tokens, database or host environment):
# HOST_UI_TLS_CERT_PATH=..\host\certs\host.crt
# HOST_UI_TLS_KEY_PATH=..\host\certs\host.key

UI_TARGET_FILE=.\.data\ui-target.json

# Disabled unless this dedicated key is explicitly supplied.
# HOST_UI_OPENAI_API_KEY=
# HOST_UI_OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# HOST_UI_OPENAI_TTS_MODEL=tts-1
# HOST_UI_OPENAI_SUMMARY_MODEL=gpt-4o-mini
